# ==========================================================================
#  Agendador — variaveis de ambiente. Copie para .env e preencha.
#  NUNCA versione o .env real (ja esta no .gitignore). Nada aqui tem valor real.
# ==========================================================================

# ---- Google OAuth (OBRIGATORIO) ----
# Credencial OAuth Client do tipo "Web" criada no Google Cloud Console, com o
# Google Calendar API ativo. Registre o redirect_uri:
#   https://SEU-SUBDOMINIO/oauth/callback
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# ---- Dominio publico (OBRIGATORIO) ----
# URL onde o agendador vai rodar. Usada no OAuth redirect e nos links das
# mensagens de reagendamento. Sem barra no final.
PUBLIC_BASE_URL=https://agendar.seudominio.com

# ---- Google Calendar ----
# "primary" = agenda principal da conta conectada. Troque so se usar outra.
CALENDAR_ID=primary
# E-mail do DONO: convidado em todo evento (fecha a agenda dele). Opcional.
OWNER_EMAIL=
# Convidados fixos da equipe (attendees em todo evento), separados por virgula.
# Ex: MEET_GUESTS_FIXOS=fulano@empresa.com,ciclana@empresa.com
MEET_GUESTS_FIXOS=

# ---- Marca / identidade ----
# Nome da sua empresa (aparece nas paginas e nas mensagens).
BRAND_NAME=Sua Empresa
# Titulo do evento agendado (ex: "Apresentação", "Reunião", "Demonstração").
EVENT_TITLE=Apresentação
# WhatsApp da sua marca, so digitos (ex: 5511999999999). Vira link no rodape. Opcional.
BRAND_WHATSAPP=

# ---- Admin (painel /admin, HTTP Basic) ----
ADMIN_USER=admin
# DEFINA uma senha forte. Sem ADMIN_PASS, o login principal fica desabilitado.
ADMIN_PASS=
# Logins adicionais opcionais, com hash werkzeug pbkdf2. Formato:
#   ADMIN_USERS=usuario1:pbkdf2:sha256:...,usuario2:pbkdf2:sha256:...
# Gere um hash com:
#   python -c "from werkzeug.security import generate_password_hash as g; print(g('SUA_SENHA', method='pbkdf2:sha256'))"
ADMIN_USERS=

# ---- Servidor ----
# Porta local do Flask (o reverse proxy/Caddy encaminha pra ca).
PORT=5120
# Fuso horario (padrao America/Sao_Paulo). Opcional.
TIMEZONE=America/Sao_Paulo

# ---- Parametros de agenda (opcionais; tem defaults sensatos no config.py) ----
# EVENT_DURATION_MIN=40
# BUFFER_MIN=20
# SLOT_STEP_MIN=60
# BOOKING_HORIZON_DAYS=14
# MIN_LEAD_HOURS=3

# ---- WhatsApp via Evolution API (OPCIONAL) ----
# Se nao configurar, o envio de WhatsApp vira no-op (o agendamento segue normal,
# so sem a mensagem automatica de confirmacao/lembrete).
EVOLUTION_URL=
EVOLUTION_INSTANCE=
EVOLUTION_API_KEY=
# Notificacao interna da equipe por WhatsApp a cada agendamento. Formato:
#   TEAM_NOTIFY_WHATSAPP=Fulano:5511999999999,Ciclana:5511888888888
TEAM_NOTIFY_WHATSAPP=

# ---- Notificacao Telegram (OPCIONAL, desligada por default) ----
# Pasta "outbox" onde um bot proprio le arquivos JSON e envia ao Telegram.
# Deixe vazio pra desligar (recomendado se voce nao tem esse bot).
OUTBOX_DIR=
# chat_id de destino da notificacao interna (se usar OUTBOX_DIR).
NOTIFY_TELEGRAM_CHAT_ID=

# ---- Integracao com painel de campanhas/CRM proprio (OPCIONAL) ----
# Se preenchido, um agendamento cujo telefone seja lead e marcado "qualificado".
PAINEL_CAMPANHAS_URL=
PAINEL_CAMPANHAS_TOKEN=
